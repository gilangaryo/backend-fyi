generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  phone        String?  @db.Text
  role         Role     @default(USER)
  refreshToken String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders    Order[]
  addresses ShippingAddress[]
  payments  Payment[]
}

enum Role {
  ADMIN
  USER
  VENDOR
  EMPLOYEE
}

enum PaymentProvider {
  MIDTRANS
  XENDIT
}

/// Product
model Product {
  id          String  @id @default(uuid())
  slug        String  @unique
  title       String
  description String? @db.Text
  price       Decimal @db.Decimal(18, 2)
  stock       Int     @default(0)
  sku         String? @unique
  imageUrl    String?

  details     String? @db.Text
  delivery    String? @db.Text
  status      Boolean @default(true)
  modelHeight Float?
  modelWeight Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  variants     ProductVariant[]
  images       ProductImage[]
  category     Category?        @relation(fields: [categoryId], references: [id])
  categoryId   String?
  collection   Collection?      @relation(fields: [collectionId], references: [id])
  collectionId String?
  kain         Kain?            @relation(fields: [kainId], references: [id])
  kainId       String?

  orderItems        OrderItem[]
  suggestedProducts SuggestedProduct[]
  promotionTargets  DiscountProductTarget[]
  measurementFields MeasurementField[]

  // indexes
  @@index([categoryId])
  @@index([collectionId])
  @@index([createdAt])
  @@index([price])
  @@index([kainId])
  @@index([stock])
  @@index([title])
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  size      String? // "S", "M", "L", "XL", "FREE SIZE", dll
  color     String?
  stock     Int     @default(0)
  sku       String?

  bust   String?
  waist  String?
  length String?
  sleeve String?
  height String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  OrderItem OrderItem[]
  measurements ProductVariantMeasurement[]

  @@index([productId])
}

model MeasurementField {
  id          String   @id @default(uuid())
  productId   String
  name        String
  displayName String
  unit        String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  measurements ProductVariantMeasurement[]

  @@unique([productId, name])
  @@index([productId, position])
}

model ProductVariantMeasurement {
  id        String   @id @default(uuid())
  variantId String
  fieldId   String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  field   MeasurementField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([variantId, fieldId])
  @@index([fieldId])
}

model ProductImage {
  id          String  @id @default(uuid())
  productId   String
  imageUrl    String
  isPrimary   Boolean @default(false)
  isSecondary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// Kain / Fabric
model Kain {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([name])
}

/// Category & Collection
model Category {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([title])
}

model Collection {
  id             String  @id @default(uuid())
  title          String
  description    String  @db.Text
  subDescription String? @db.Text
  quote          String  @db.Text
  heroImage      String?
  status         Boolean @default(true)
  position       Int     @default(0)

  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products         Product[]
  promotionTargets DiscountCollectionTarget[]

  @@index([title])
}

/// Order & Payment

/// Payment
model Payment {
  id               String           @id @default(uuid())
  userId           String
  orderId          String
  provider         PaymentProvider?
  referenceId      String           @unique
  paymentRequestId String           @unique
  paymentLinkUrl   String?
  amount           Decimal          @db.Decimal(18, 2)
  status           PaymentStatus    @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  expiredAt        DateTime?
  user             User             @relation(fields: [userId], references: [id])
  order            Order            @relation(fields: [orderId], references: [id])
  refunds          Refund[]

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

model Refund {
  id              String   @id @default(uuid())
  paymentId       String
  refundRequestId String   @unique
  amount          Decimal  @db.Decimal(18, 2)
  reason          String?
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([status])
}

model Order {
  id                 String      @id @default(uuid())
  userId             String
  status             OrderStatus @default(DRAFT)
  total              Decimal     @db.Decimal(18, 2)
  shippingCost       Decimal?    @db.Decimal(18, 2)
  subTotal           Decimal     @db.Decimal(18, 2)
  discountTotal      Decimal     @default(0) @db.Decimal(18, 2)
  xenditPaymentId    String?
  referenceId        String?
  bytestepShipmentId String?
  shippingAddressId  String?
  courierCompany     String?
  discountId         String?
  giftNote           String?
  pricingBreakdown   Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user            User               @relation(fields: [userId], references: [id])
  items           OrderItem[]
  statusLogs      OrderStatusLog[]
  tracking        ShipmentTracking[]
  shippingAddress ShippingAddress?   @relation(fields: [shippingAddressId], references: [id])

  discount Discount? @relation(fields: [discountId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String?
  quantity        Int
  priceAtPurchase Decimal  @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  variantId       String?

  order   Order           @relation(fields: [orderId], references: [id])
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderStatusLog {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
}

/// Shipping
model ShippingAddress {
  id        String @id @default(uuid())
  userId    String
  firstName String
  lastName  String

  country        String
  address        String  @db.Text
  addressDetails String? @db.Text

  city       String?
  province   String?
  district   String?
  village    String?
  postalCode String?
  phone      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId])
  @@index([city])
  @@index([province])
}

model ShipmentTracking {
  id                String    @id @default(uuid())
  orderId           String
  courier           String
  trackingId        String
  waybillId         String?
  trackingLink      String?
  estimatedDelivery DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([courier])
  @@index([trackingId])
}

/// Discounts / Coupons
model Discount {
  id                 String       @id @default(uuid())
  title              String
  code               String       @unique
  kind               DiscountKind @default(MINIMUM_PURCHASE_DISCOUNT)
  type               DiscountType
  value              Decimal      @db.Decimal(18, 2)
  startsAt           DateTime?
  expiresAt          DateTime
  priority           Int          @default(100)
  usedCount          Int          @default(0)
  minimumOrderAmount Decimal?     @db.Decimal(18, 2)
  minimumQty         Int?
  combinableWith     Json?
  autoApply          Boolean      @default(false)
  status             Boolean      @default(true)
  deletedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders            Order[]
  collectionTargets DiscountCollectionTarget[]
  productTargets    DiscountProductTarget[]

  @@index([code])
  @@index([deletedAt])
  @@index([expiresAt])
  @@index([kind])
  @@index([startsAt])
}

model DiscountCollectionTarget {
  id           String   @id @default(uuid())
  discountId   String
  collectionId String
  createdAt    DateTime @default(now())

  discount   Discount   @relation(fields: [discountId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([discountId, collectionId])
  @@index([discountId])
  @@index([collectionId])
}

model DiscountProductTarget {
  id         String   @id @default(uuid())
  discountId String
  productId  String
  createdAt  DateTime @default(now())

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([discountId, productId])
  @@index([discountId])
  @@index([productId])
}

enum DiscountKind {
  COLLECTION_DISCOUNT
  SPECIFIC_PRODUCT_DISCOUNT
  MINIMUM_PURCHASE_DISCOUNT
  MINIMUM_QTY_DISCOUNT
}

enum DiscountType {
  PERCENT
  VALUE
}

enum PaymentStatus {
  PENDING // Invoice dibuat, menunggu pembayaran
  PAID // Pembayaran berhasil diterima
  FAILED // Pembayaran gagal
  REFUNDED // Dana dikembalikan
  EXPIRED // Tagihan kedaluwarsa
}

enum OrderStatus {
  DRAFT // Order baru dibuat (otomatis sebelum pembayaran PAID / sedang PENDING)
  NEW // Order setelah pembayaran PAID
  PACKED // Barang sedang dikemas
  SHIPPED // Barang sedang dikirim
  DELIVERED // Barang sudah diterima
  CANCELLED // Order dibatalkan
  RETURNED // Barang dikembalikan
  REFUNDED // Dana dikembalikan penuh
  EXPIRED
}

model Blog {
  id          String    @id @default(uuid())
  event       String
  title       String
  description String    @db.Text
  slug        String    @unique
  date        DateTime? @default(now())
  heroImage   String?

  // Section 1
  firstHeaderImage String?
  firstHeading     String?
  firstDescription String? @db.Text

  // Section 2
  secondHeaderImage String?
  secondHeading     String?
  secondDescription String? @db.Text

  // Section 3
  thirdHeaderImage    String?
  thirdHeading        String?
  thirdDescription    String? @db.Text
  thirdSubDescription String? @db.Text

  imageDivider      String?
  quote             String? @db.Text
  firstFooterImage  String?
  secondFooterImage String?

  // Section 4 tdk pakai
  fourthHeaderImage String?
  fourthHeading     String?
  fourthDescription String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id       String  @id @default(uuid())
  key      String  @unique
  value    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id             String           @id @default(uuid())
  email          String           @unique
  name           String?
  source         String?
  isVerified     Boolean          @default(false)
  subscribedAt   DateTime         @default(now())
  unsubscribedAt DateTime?
  status         SubscriberStatus @default(ACTIVE)

  @@index([email])
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  PENDING
}

model SuggestedProduct {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String

  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
  @@index([position])
}
