# App
NODE_ENV=development
PORT=4300

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fyi_db

# Auth
JWT_SECRET=your_jwt_secret_here

# Frontend
FRONTEND_URL=http://localhost:3000

# Payment Provider (xendit | midtrans)
PAYMENT_PROVIDER=midtrans

# Xendit
XENDIT_SECRET_KEY=xnd_production_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
XENDIT_WEBHOOK_TOKEN=your_xendit_webhook_token

# Midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Shipping (Biteship)
BITESHIP_API_KEY=biteship_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mailer (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_password
MAIL_FROM=your_email@gmail.com
